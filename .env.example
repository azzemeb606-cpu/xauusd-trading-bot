# =============================================================================
# XAUUSD Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
DATA_DIR=./data

# ⚠ Generate a secure token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=CHANGE_ME_use_a_32_char_random_hex

# CORS: set to your dashboard domain in production
CORS_ORIGIN=*

# ── Scraper ───────────────────────────────────────────────────────────────────
RADAR_URL=https://xauusdlivechart.com/007
MAIN_URL=https://xauusdlivechart.com/
POLL_MIN_MS=3000
POLL_MAX_MS=5000
PAGE_RELOAD_MINUTES=15
FEED_STALE_SECONDS=60
SCRAPER_HEADLESS=true
PRICE_MIN=1000
PRICE_MAX=10000

# ── Execution engine: "paper" (safe default) or "metaapi" ─────────────────────
EXECUTION_ENGINE=paper
# METAAPI_TOKEN=your-metaapi-cloud-token
# METAAPI_DOMAIN=       # optional custom MetaApi domain

# ── Trading mode: DEMO_ONLY | LIVE_ONLY | DUAL_MIRROR ────────────────────────
TRADING_MODE=DEMO_ONLY
AUTO_TRADING=false

# ── Live trading safety lock (BOTH required to enable live orders) ────────────
LIVE_TRADING_ENABLED=false
# LIVE_TRADING_CONFIRM=I_UNDERSTAND_THE_RISK

# ── MetaApi account IDs ───────────────────────────────────────────────────────
# DEMO_ACCOUNT_ID=your-demo-account-uuid
# LIVE_ACCOUNT_ID=your-live-account-uuid
DEMO_SYMBOL=XAUUSD
LIVE_SYMBOL=XAUUSD
MAGIC=7007

# ── Paper broker (used when EXECUTION_ENGINE=paper) ──────────────────────────
PAPER_START_BALANCE=10000
PAPER_SPREAD=0.30

# ── Risk management ───────────────────────────────────────────────────────────
RISK_PERCENT=1
FIXED_LOT=0              # 0 = use RISK_PERCENT sizing
MAX_LOT=1
TP_SPLIT=50,30,20        # % volume for TP1, TP2, TP3
MIN_RR=1.2
MIN_SL_DISTANCE=2        # USD
MAX_SL_DISTANCE=30       # USD
MAX_SPREAD=0.80          # USD — above this no trade is placed
MAX_ENTRY_DEVIATION=2    # USD — market order within this distance of entry

# ── Signal ────────────────────────────────────────────────────────────────────
SIGNAL_MAX_AGE_SECONDS=600
CONFLUENCE_MODE=NO_CONFLICT   # STRICT | NO_CONFLICT | OFF

# ── Session & drawdown ────────────────────────────────────────────────────────
SESSION_WINDOWS=00:00-23:59   # e.g. "07:00-20:00" for London+NY only (UTC)
BLACKOUT_WINDOWS=             # e.g. "12:55-13:05,20:55-21:05" for news events
MAX_OPEN_GROUPS=1
MAX_DAILY_DRAWDOWN_PCT=5
DAILY_DD_WARN_PCT=3
COOLDOWN_AFTER_LOSS_MIN=30
MIN_MARGIN_LEVEL=300

# ── Strict 6-Gate Trade Criteria Validator ──────────────────────────────────
MIN_FUSION_CONFIDENCE=65        # Criteria 2: Minimum % confidence required to enter
MIN_BRAINS_AGREEMENT=5          # Criteria 2: Minimum aligned engines count
MAX_LIMIT_PROXIMITY=15          # Criteria 4: Max distance ($) from zone to place pending limit
ALLOW_PENDING_ORDERS=true       # Criteria 4: Allow BUY/SELL LIMIT at anchor when near zone
NEWS_BLACKOUT_MIN=15            # Criteria 1: Minutes buffer before/after high-impact USD news

# ── Order preferences ─────────────────────────────────────────────────────────
ORDER_TYPE_PREFERENCE=AUTO   # AUTO | MARKET | LIMIT
PENDING_EXPIRY_MINUTES=60
MOVE_BE_ON_TP1=true
TRAIL_TO_TP1_ON_TP2=true
BE_BUFFER=0.30              # USD above/below entry for SL break-even
NOTIFY_GATE_BLOCKS=false    # notify when a setup is blocked (noisy)

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot via @BotFather, obtain token, then get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# ── Email (Gmail SMTP / Nodemailer) ───────────────────────────────────────────
# Use your Google Account App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=XAUUSD Automated Bot <noreply@xauusdbot.local>
EMAIL_TO=irfan7242@gmail.com

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# Choose ONE provider: callmebot | ultramsg | twilio | meta | none
WHATSAPP_PROVIDER=callmebot

# 1. CallMeBot Free API (Get free API key: message "+34 644 44 49 19" with "I allow callmebot to send me messages")
# Format: "PHONE_WITH_COUNTRY_CODE:API_KEY" (e.g. 923001234567:123456)
CALLMEBOT_RECIPIENTS=

# 2. UltraMsg WhatsApp API (https://ultramsg.com)
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
# Target phone numbers with country code (e.g. +923001234567)
WHATSAPP_TO=

# 3. Twilio WhatsApp API
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# 4. Meta WhatsApp Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# ── Timezone for daily drawdown reset ────────────────────────────────────────
DAY_RESET_TZ=UTC
